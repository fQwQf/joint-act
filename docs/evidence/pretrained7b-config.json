{
  "model": {
    "backbone": "openvla",
    "pretrained": "${REMOTE_WORKDIR}/pretrained-openvla7b",
    "revision": null,
    "hidden_dim": 32,
    "head_dim": 64,
    "action_dim": 7,
    "proprio_dim": 8,
    "horizon": 4,
    "num_modes": 8,
    "num_images": 2,
    "image_size": 224,
    "max_text_length": 128,
    "lora_rank": 2,
    "lora_alpha": 4,
    "freeze_vision": true,
    "freeze_projector": true,
    "gradient_checkpointing": true,
    "residual_scale": 1.0,
    "head_type": "joint"
  },
  "data": {
    "root": "${REMOTE_WORKDIR}/real-libero",
    "artifacts": "${REMOTE_WORKDIR}/pretrained7b-smoke/artifacts",
    "teacher": null,
    "image_aug": false,
    "crop_scale": 0.9,
    "workers": 0
  },
  "train": {
    "output": "${REMOTE_WORKDIR}/pretrained7b-smoke/run",
    "seed": 42,
    "device": "cpu",
    "precision": "bf16",
    "batch_size": 1,
    "grad_accumulation": 1,
    "max_steps": 2,
    "learning_rate": 0.003,
    "weight_decay": 0.01,
    "warmup_steps": 0,
    "grad_clip": 1.0,
    "log_every": 1,
    "save_every": 1,
    "eval_every": 2,
    "eval_batches": 1,
    "keep_checkpoints": 3,
    "resume": "${REMOTE_WORKDIR}/pretrained7b-smoke/run/checkpoints",
    "brier_weight": 0.1,
    "residual_weight": 1.0,
    "distill_weight": 0.0,
    "min_free_disk_gb": 0.2,
    "allow_shared_gpu": false
  }
}
